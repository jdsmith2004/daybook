# Sync for a phone build. Copy this file to .env.local (git ignores it) and fill in the values the Deploy workflow prints in
# its summary, or set them as EAS environment variables for EAS builds. None of them is secret: they are the app's public
# sign-in client and addresses, and the web app carries the same values. Leave them empty for a build without sync.
EXPO_PUBLIC_SYNC_URL=
EXPO_PUBLIC_AUTH_DOMAIN=
EXPO_PUBLIC_CLIENT_ID=
