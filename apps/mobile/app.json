{
  "expo": {
    "name": "Daybook",
    "slug": "daybook",
    "owner": "jeffspresso",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jdsmith2004.daybook",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jdsmith2004.daybook",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1B1550",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Daybook",
      "shortName": "Daybook",
      "themeColor": "#FFF8EB",
      "backgroundColor": "#FFF8EB"
    },
    "plugins": [
      "expo-router",
      "./plugins/night-pack",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Daybook uses the microphone only when you record a voice note to yourself. The note stays on this phone.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "On the trail, Daybook can show you your own face for a moment during a hard craving. Nothing is recorded, saved or sent.",
          "microphonePermission": "Daybook uses the microphone only when you record a voice note to yourself. The note stays on this phone.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#15123A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png",
          "largeIcon": "./assets/images/notification-large.png",
          "color": "#6247EA"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daybook uses Face ID to keep your log private."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Daybook uses Face ID to keep your log private."
        }
      ],
      "expo-web-browser",
      "expo-iap",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.jdsmith2004.daybook",
          "widgets": [
            {
              "name": "Flame",
              "displayName": "Your flame",
              "description": "Your flame as it burns now. Tap it for today, or SOS for help.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge", "accessoryCircular", "accessoryRectangular", "accessoryInline"],
                "initialLayout": "./src/widgets/flame.tsx"
              },
              "android": null
            },
            {
              "name": "Sos",
              "displayName": "SOS",
              "description": "One tap opens SOS.",
              "ios": {
                "supportedFamilies": ["systemSmall", "accessoryCircular"],
                "initialLayout": "./src/widgets/sos.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Daybook reads how long you slept, to show you how your nights and your hard days line up. It stays on this phone and is never sent anywhere.",
          "NSHealthUpdateUsageDescription": "Daybook never writes to Apple Health. It only reads how long you slept, and that stays on this phone.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "A private, honest companion for changing a habit.",
    "backgroundColor": "#FFF8EB",
    "extra": {
      "eas": {
        "projectId": "47843351-7cbe-4495-aa73-09f662f84b6c"
      }
    }
  }
}
