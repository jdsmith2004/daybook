{
  "expo": {
    "name": "Daybook",
    "slug": "daybook",
    "owner": "jeffspresso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jdsmith2004.daybook",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jdsmith2004.daybook",
      "adaptiveIcon": {
        "backgroundColor": "#1B1550",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Daybook",
      "shortName": "Daybook",
      "themeColor": "#FFF8EB",
      "backgroundColor": "#FFF8EB"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Daybook uses the microphone only when you record a voice note to yourself. The note stays on this phone.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#15123A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/notification-icon.png",
          "largeIcon": "./assets/images/notification-large.png",
          "color": "#6247EA"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daybook uses Face ID to keep your log private."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Daybook uses Face ID to keep your log private."
        }
      ],
      "expo-web-browser",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "A private, honest companion for changing a habit.",
    "backgroundColor": "#FFF8EB",
    "extra": {
      "eas": {
        "projectId": "47843351-7cbe-4495-aa73-09f662f84b6c"
      }
    }
  }
}
