{
  "name": "daybook",
  "private": true,
  "description": "Daybook: a private, honest habit-change companion. iOS, Android and web from one codebase.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "icons": "node tools/make-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "3.8.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
